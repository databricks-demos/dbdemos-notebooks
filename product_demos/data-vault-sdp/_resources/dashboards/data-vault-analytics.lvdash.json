{
  "datasets": [
    {
      "name": "revenue_by_nation",
      "displayName": "Revenue by Nation",
      "queryLines": [
        "SELECT\n",
        "  dn.nation_name,\n",
        "  SUM(fl.net_revenue) as total_revenue,\n",
        "  COUNT(DISTINCT fl.order_id) as order_count\n",
        "FROM main.dbdemos_data_vault_sdp.fact_lineitem fl\n",
        "JOIN main.dbdemos_data_vault_sdp.dim_nation dn ON fl.nation_key = dn.nation_key\n",
        "GROUP BY dn.nation_name\n",
        "ORDER BY total_revenue DESC\n"
      ]
    },
    {
      "name": "revenue_by_segment",
      "displayName": "Revenue by Market Segment",
      "queryLines": [
        "SELECT\n",
        "  dc.market_segment,\n",
        "  SUM(fl.net_revenue) as total_revenue,\n",
        "  AVG(fl.net_revenue) as avg_revenue\n",
        "FROM main.dbdemos_data_vault_sdp.fact_lineitem fl\n",
        "JOIN main.dbdemos_data_vault_sdp.dim_customer dc ON fl.customer_key = dc.customer_key\n",
        "GROUP BY dc.market_segment\n",
        "ORDER BY total_revenue DESC\n"
      ]
    },
    {
      "name": "order_status_summary",
      "displayName": "Order Status Distribution",
      "queryLines": [
        "SELECT\n",
        "  order_status,\n",
        "  COUNT(DISTINCT order_id) as order_count,\n",
        "  SUM(net_revenue) as revenue\n",
        "FROM main.dbdemos_data_vault_sdp.fact_order_summary\n",
        "GROUP BY order_status\n"
      ]
    },
    {
      "name": "satellite_history_sample",
      "displayName": "Satellite History (SCD2 Example)",
      "queryLines": [
        "SELECT\n",
        "  h.c_custkey,\n",
        "  s.c_acctbal,\n",
        "  s.__START_AT as valid_from,\n",
        "  s.__END_AT as valid_to,\n",
        "  CASE WHEN s.__END_AT IS NULL THEN 'Current' ELSE 'Historical' END as version_status\n",
        "FROM main.dbdemos_data_vault_sdp.sat_customer s\n",
        "JOIN main.dbdemos_data_vault_sdp.hub_customer h USING (customer_hk)\n",
        "WHERE h.c_custkey IN (1, 2, 3, 4, 5)\n",
        "ORDER BY h.c_custkey, s.__START_AT DESC\n"
      ]
    },
    {
      "name": "order_metrics_summary",
      "displayName": "Order Metrics",
      "queryLines": [
        "SELECT\n",
        "  line_count,\n",
        "  AVG(net_revenue) as avg_revenue,\n",
        "  SUM(total_quantity) as total_quantity,\n",
        "  COUNT(*) as order_count\n",
        "FROM main.dbdemos_data_vault_sdp.fact_order_summary\n",
        "GROUP BY line_count\n",
        "ORDER BY line_count\n"
      ]
    }
  ],
